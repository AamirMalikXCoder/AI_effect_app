rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own profile; writes go through Cloud Functions only.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Generation history: read own, never write directly.
    match /generations/{genId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Reports for the mandatory AI-content flag button (Play policy).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'generationId', 'reason', 'createdAt']);
      allow read, update, delete: if false;
    }
  }
}
